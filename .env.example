# Access Token (optional for now — strongly recommended on any public URL)
# Unset: auth is OFF and anyone with the URL can read, delete, and spend your
# LLM quota. Set: gates every page and API route. The web UI asks for it once
# at /unlock; the Chrome extension and Zotero script send it as a Bearer
# header. Generate one with:  openssl rand -base64 32
LEXIS_SECRET_TOKEN=

# Supabase Configuration (required in production)
# The server uses the service-role key; the anon key is not used.
# Apply every file in supabase/migrations/ in order.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM API Keys (Supported: Gemini or OpenAI)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only: without Supabase, an in-memory store is used and
# reset on every restart. It is refused in production unless this is "true".
# LEXIS_ALLOW_MEMORY_STORE=true
