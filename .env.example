# LLM API Keys (Supported: Gemini or OpenAI)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
